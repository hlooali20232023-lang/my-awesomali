import { useEffect, useMemo, useState } from 'react';

type Language = 'en' | 'ar';

type Product = {
  id: string;
  name: { en: string; ar: string };
  description: { en: string; ar: string };
  price: number;
  stock: number;
  category: { en: string; ar: string };
  accent: string;
  emoji: string;
};

const defaultProducts: Product[] = [
  {
    id: 'aero-speaker',
    name: { en: 'Aero Speaker', ar: 'مكبر صوت Aero' },
    description: {
      en: '360° immersive sound with a warm premium finish.',
      ar: 'صوت شامل 360° مع تصميم فاخر ودافئ.'
    },
    price: 249,
    stock: 3,
    category: { en: 'Audio', ar: 'الصوت' },
    accent: 'from-violet-500 to-purple-600',
    emoji: '🎵'
  },
  {
    id: 'orbit-watch',
    name: { en: 'Orbit Watch', ar: 'ساعة Orbit' },
    description: {
      en: 'Minimal smartwatch built for everyday motion.',
      ar: 'ساعة ذكية أنيقة مصممة للحركة اليومية.'
    },
    price: 399,
    stock: 2,
    category: { en: 'Wearables', ar: 'ملحقات' },
    accent: 'from-sky-500 to-cyan-600',
    emoji: '⌚'
  },
  {
    id: 'luma-lamp',
    name: { en: 'Luma Lamp', ar: 'مصباح Luma' },
    description: {
      en: 'Soft ambient lighting for calm and focused moments.',
      ar: 'إضاءة ناعمة لتجربة هادئة ومركزة.'
    },
    price: 189,
    stock: 1,
    category: { en: 'Home', ar: 'المنزل' },
    accent: 'from-amber-400 to-orange-500',
    emoji: '💡'
  },
  {
    id: 'drift-case',
    name: { en: 'Drift Case', ar: 'غطاء Drift' },
    description: {
      en: 'Elegant protection for the devices you use every day.',
      ar: 'حماية أنيقة للأجهزة التي تستخدمها يومياً.'
    },
    price: 79,
    stock: 0,
    category: { en: 'Travel', ar: 'السفر' },
    accent: 'from-rose-500 to-pink-600',
    emoji: '👜'
  }
];

const translations = {
  en: {
    brand: 'Nexa',
    shopNow: 'Shop now',
    launch: 'NEW SEASON LAUNCH',
    heroTitle: 'Curated essentials for an elevated life.',
    heroBody:
      'Discover premium technology, home pieces, and everyday favorites designed to simplify your routine with style.',
    explore: 'Explore collection',
    lookbook: 'See lookbook',
    stats: {
      customers: 'Happy Customers',
      reviews: 'Product Reviews',
      delivery: 'Fast Delivery',
      support: 'Support'
    },
    admin: 'Admin',
    book: 'Book now',
    soldOut: 'Sold out',
    onlyOne: 'Only 1 left',
    onlyFew: 'Only {count} left',
    available: 'Available',
    addToCart: 'Add to cart',
    language: 'EN',
    langLabel: 'العربية',
    emptyState: 'No products available right now.'
  },
  ar: {
    brand: 'نيكسا',
    shopNow: 'تسوق الآن',
    launch: 'إطلاق جديد',
    heroTitle: 'منتجات مختارة لحياة أكثر أناقة.',
    heroBody:
      'اكتشف التقنيات الفاخرة، وأدوات المنزل، والمفضلات اليومية المصممة لتبسيط روتينك بأسلوب أنيق.',
    explore: 'استكشف المجموعة',
    lookbook: 'شاهد المنظر',
    stats: {
      customers: 'عملاء سعداء',
      reviews: 'تقييمات المنتجات',
      delivery: 'توصيل سريع',
      support: 'الدعم'
    },
    admin: 'لوحة التحكم',
    book: 'احجز الآن',
    soldOut: 'انتهت',
    onlyOne: 'تبقت قطعة واحدة فقط',
    onlyFew: 'تبقى {count} قطع',
    available: 'متوفر',
    addToCart: 'أضف للسلة',
    language: 'AR',
    langLabel: 'English',
    emptyState: 'لا توجد منتجات متاحة حالياً.'
  }
};

const getStockStatus = (stock: number, t: typeof translations.en) => {
  if (stock <= 0) return { label: t.soldOut, tone: 'red' };
  if (stock === 1) return { label: t.onlyOne, tone: 'amber' };
  if (stock <= 3) return { label: t.onlyFew.replace('{count}', String(stock)), tone: 'amber' };
  return { label: t.available, tone: 'green' };
};

export default function HomePage() {
  const [language, setLanguage] = useState<Language>('en');
  const [products, setProducts] = useState<Product[]>(defaultProducts);

  useEffect(() => {
    const saved = localStorage.getItem('nexa-products');
    if (saved) {
      try {
        const parsed = JSON.parse(saved) as Product[];
        if (Array.isArray(parsed) && parsed.length) setProducts(parsed);
      } catch {
        // no-op
      }
    }

    const savedLang = localStorage.getItem('nexa-language') as Language | null;
    if (savedLang === 'en' || savedLang === 'ar') setLanguage(savedLang);
  }, []);

  useEffect(() => {
    localStorage.setItem('nexa-products', JSON.stringify(products));
  }, [products]);

  useEffect(() => {
    localStorage.setItem('nexa-language', language);
  }, [language]);

  const t = useMemo(() => translations[language], [language]);

  const handleBook = (id: string) => {
    setProducts((prev) =>
      prev.map((product) =>
        product.id === id && product.stock > 0
          ? { ...product, stock: Math.max(0, product.stock - 1) }
          : product
      )
    );
  };

  const stats = [
    { value: '24k+', label: t.stats.customers },
    { value: '4.9/5', label: t.stats.reviews },
    { value: '2 days', label: t.stats.delivery },
    { value: '24/7', label: t.stats.support }
  ];

  return (
    <main className="min-h-screen bg-[#f4f0eb] text-slate-900">
      <div className="mx-auto max-w-6xl px-4 py-5 md:px-8">
        <header className="flex items-center justify-between rounded-full border border-slate-200 bg-white/60 px-4 py-3 shadow-sm backdrop-blur-sm">
          <div className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white">N</div>
            <span className="text-2xl font-semibold">{t.brand}</span>
          </div>

          <div className="flex items-center gap-3">
            <button
              onClick={() => setLanguage((prev) => (prev === 'en' ? 'ar' : 'en'))}
              className="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700"
            >
              {t.langLabel}
            </button>
            <a
              href="/admin"
              className="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
            >
              {t.admin}
            </a>
          </div>
        </header>

        <section className="mt-10 rounded-[30px] border border-slate-200 bg-white/70 p-5 shadow-sm md:p-8">
          <div className="inline-flex rounded-full border border-violet-200 bg-violet-50 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-violet-700">
            {t.launch}
          </div>

          <h1 className="mt-8 text-5xl font-black leading-[0.9] tracking-[-0.06em] text-slate-900 md:text-8xl">
            {t.heroTitle}
          </h1>

          <p className="mt-6 max-w-3xl text-xl leading-8 text-slate-700 md:text-2xl">
            {t.heroBody}
          </p>

          <div className="mt-8 flex flex-wrap gap-4">
            <button className="rounded-full bg-slate-900 px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-slate-900/10">
              {t.explore}
            </button>
            <button className="rounded-full border border-slate-300 bg-white px-8 py-4 text-lg font-semibold text-slate-900">
              {t.lookbook}
            </button>
          </div>

          <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {stats.map((item) => (
              <div key={item.label}>
                <div className="text-4xl font-black text-slate-900 md:text-5xl">{item.value}</div>
                <div className="mt-2 text-base text-slate-600 md:text-lg">{item.label}</div>
              </div>
            ))}
          </div>
        </section>

        <section className="mt-12">
          <div className="mb-6 flex items-center justify-between">
            <h2 className="text-3xl font-black tracking-tight text-slate-900 md:text-4xl">
              {language === 'en' ? 'Featured products' : 'المنتجات المميزة'}
            </h2>
          </div>

          <div className="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            {products.length ? (
              products.map((product) => {
                const stockStatus = getStockStatus(product.stock, t);
                const isDisabled = product.stock <= 0;

                return (
                  <div
                    key={product.id}
                    className={`rounded-[30px] border p-4 shadow-sm transition ${
                      isDisabled
                        ? 'border-red-200 bg-red-50'
                        : stockStatus.tone === 'amber'
                          ? 'border-amber-200 bg-amber-50'
                          : 'border-emerald-200 bg-emerald-50'
                    }`}
                  >
                    <div className={`flex h-48 items-center justify-center rounded-[24px] bg-gradient-to-br ${product.accent} text-7xl`}>
                      {product.emoji}
                    </div>

                    <div className="mt-5 flex items-center justify-between gap-3">
                      <span className="rounded-full bg-white/60 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-slate-700">
                        {product.category[language]}
                      </span>
                      <span className="text-2xl font-black text-slate-900">${product.price}</span>
                    </div>

                    <h3 className="mt-4 text-2xl font-bold text-slate-900">{product.name[language]}</h3>
                    <p className="mt-2 text-sm leading-6 text-slate-700">
                      {product.description[language]}
                    </p>

                    <div className="mt-4 flex items-center justify-between">
                      <span
                        className={`rounded-full px-2.5 py-1 text-xs font-bold ${
                          stockStatus.tone === 'red'
                            ? 'bg-red-100 text-red-700'
                            : stockStatus.tone === 'amber'
                              ? 'bg-amber-100 text-amber-700'
                              : 'bg-emerald-100 text-emerald-700'
                        }`}
                      >
                        {stockStatus.label}
                      </span>
                      <span className="text-sm font-medium text-slate-500">{product.stock} {language === 'en' ? 'left' : 'متبقي'}</span>
                    </div>

                    <button
                      onClick={() => handleBook(product.id)}
                      disabled={isDisabled}
                      className={`mt-5 w-full rounded-full px-4 py-3 text-sm font-bold transition ${
                        isDisabled
                          ? 'cursor-not-allowed bg-red-200 text-red-700'
                          : 'bg-slate-900 text-white hover:bg-slate-800'
                      }`}
                    >
                      {isDisabled ? t.soldOut : t.book}
                    </button>
                  </div>
                );
              })
            ) : (
              <div className="rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
                {t.emptyState}
              </div>
            )}
          </div>
        </section>
      </div>
    </main>
  );
}
